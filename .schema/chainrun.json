{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vikingpingvin/chainrun/schema/chainrun.json",
  "title": "ChainRun Workflow Config",
  "description": "Root configuration for ChainRun workflow definitions.",
  "type": "object",
  "required": [
    "workflows"
  ],
  "additionalProperties": false,
  "properties": {
    "workflows": {
      "type": "array",
      "description": "List of workflow definitions.",
      "items": {
        "$ref": "#/$defs/WorkflowDef"
      }
    }
  },
  "$defs": {
    "WorkflowDef": {
      "type": "object",
      "required": [
        "name",
        "trigger",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique name for the workflow."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the workflow."
        },
        "trigger": {
          "$ref": "#/$defs/TriggerDef"
        },
        "steps": {
          "type": "array",
          "description": "Ordered list of steps to execute.",
          "items": {
            "$ref": "#/$defs/StepDef"
          }
        },
        "on_error": {
          "$ref": "#/$defs/ErrorPolicy"
        },
        "env": {
          "type": "object",
          "description": "Workflow-level environment variables.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "TriggerDef": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Trigger type.",
          "enum": [
            "cron",
            "manual",
            "webhook",
            "watch",
            "git"
          ]
        },
        "schedule": {
          "type": "string",
          "description": "Cron expression (cron trigger only). e.g. '0 * * * *'"
        },
        "path": {
          "type": "string",
          "description": "File system path to watch (watch trigger only)."
        },
        "events": {
          "type": "array",
          "description": "File events to watch for (watch trigger only).",
          "items": {
            "type": "string",
            "enum": [
              "create",
              "modify",
              "delete"
            ]
          }
        },
        "port": {
          "type": "integer",
          "description": "Port to listen on (webhook trigger only)."
        },
        "route": {
          "type": "string",
          "description": "HTTP route path (webhook trigger only). e.g. '/webhook'"
        },
        "hook": {
          "type": "string",
          "description": "Git hook name (git trigger only). e.g. 'pre-commit', 'post-push'"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "cron"
              }
            }
          },
          "then": {
            "required": [
              "schedule"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "watch"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "required": [
              "port",
              "route"
            ]
          }
        }
      ]
    },
    "StepDef": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this step. Used to reference outputs and in error policies."
        },
        "continue_on_error": {
          "type": "boolean",
          "description": "If true, the workflow continues even if this step fails.",
          "default": false
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        },
        "timeout": {
          "type": "string",
          "description": "Step timeout duration. e.g. '30s', '5m', '1h'",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "env": {
          "type": "object",
          "description": "Step-level environment variables (merged with workflow env).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "shell": {
          "$ref": "#/$defs/ShellStep"
        },
        "http": {
          "$ref": "#/$defs/HTTPStep"
        },
        "llm": {
          "$ref": "#/$defs/LLMStep"
        },
        "file": {
          "$ref": "#/$defs/FileStep"
        },
        "notify": {
          "$ref": "#/$defs/NotifyStep"
        }
      },
      "oneOf": [
        { "required": ["shell"] },
        { "required": ["http"] },
        { "required": ["llm"] },
        { "required": ["file"] },
        { "required": ["notify"] }
      ]
    },
    "ShellStep": {
      "type": "object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell command to run. Supports template variables."
        },
        "shell": {
          "type": "string",
          "description": "Shell interpreter to use. Defaults to the OS default (cmd on Windows, sh elsewhere).",
          "enum": [
            "sh",
            "bash",
            "powershell"
          ]
        }
      }
    },
    "HTTPStep": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Target URL. Supports template variables.",
          "format": "uri"
        },
        "method": {
          "type": "string",
          "description": "HTTP method. Defaults to GET.",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD"
          ],
          "default": "GET"
        },
        "headers": {
          "type": "object",
          "description": "HTTP request headers. Values support template variables.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "description": "HTTP request body. Supports template variables."
        }
      }
    },
    "LLMStep": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "LLM provider name. e.g. 'openai', 'anthropic'"
        },
        "model": {
          "type": "string",
          "description": "Model identifier. e.g. 'gpt-4o', 'claude-sonnet-4-6'"
        },
        "prompt": {
          "type": "string",
          "description": "User prompt text. Supports template variables."
        },
        "system": {
          "type": "string",
          "description": "System prompt text. Supports template variables."
        }
      }
    },
    "FileStep": {
      "type": "object",
      "required": [
        "op",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "description": "File operation to perform.",
          "enum": [
            "read",
            "write",
            "append"
          ]
        },
        "path": {
          "type": "string",
          "description": "Path to the target file. Supports template variables."
        },
        "content": {
          "type": "string",
          "description": "Content to write or append. Supports template variables."
        }
      }
    },
    "NotifyStep": {
      "type": "object",
      "required": [
        "channel",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "description": "Notification channel. e.g. 'slack', 'email', 'discord'"
        },
        "message": {
          "type": "string",
          "description": "Notification message. Supports template variables."
        },
        "to": {
          "type": "string",
          "description": "Recipient address or channel ID."
        }
      }
    },
    "RetryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "type": "integer",
          "description": "Number of retry attempts.",
          "minimum": 1
        },
        "delay": {
          "type": "string",
          "description": "Delay between retries. e.g. '5s', '1m'",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "backoff": {
          "type": "string",
          "description": "Backoff strategy.",
          "enum": [
            "fixed",
            "exponential"
          ]
        }
      }
    },
    "ErrorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "description": "What to do when the workflow encounters an error.",
          "enum": [
            "stop",
            "continue",
            "notify"
          ],
          "default": "stop"
        },
        "notify_id": {
          "type": "string",
          "description": "Step ID of a notify step to invoke on error (used when strategy is 'notify')."
        }
      }
    }
  }
}
